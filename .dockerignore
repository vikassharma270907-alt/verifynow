# Never ship secrets or local state into the image
**/.env
**/.env.*
!**/.env.example

.git
.kiro
graphify-out
everything-claude-code
docs

# Build artifacts and caches
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.hypothesis

# Tests and logs are not needed at runtime
backend/tests
backend/test_pipeline.py
test_pipeline.py
frontend/tests
frontend/npm-install.log
*.log
