{
  "version": "v1",
  "hooks": [
    {
      "name": "TypeCheck on TypeScript Edit",
      "trigger": "PostFileSave",
      "description": "Checks for type errors when TypeScript files are saved",
      "matcher": "\\\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "npx tsc --noEmit 2>&1 | Select-Object -First 20",
        "timeout": 30
      }
    }
  ]
}